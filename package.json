{
  "name": "personal-life-hub",
  "private": true,
  "version": "1.1.0",
  "description": "个人工作生活中心，本地离线桌面与手机应用",
  "author": "Personal Life Hub",
  "main": "desktop/main.cjs",
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "scripts": {
    "wechat:build": "node node_modules/typescript/bin/tsc -p wechat/tsconfig.json && node scripts/build-wechat.mjs",
    "test:wechat": "node node_modules/vitest/vitest.mjs run --config wechat/vitest.config.ts",
    "verify:wechat": "node scripts/verify-wechat.mjs",
    "desktop": "pnpm build && electron .",
    "desktop:pack": "pnpm build && electron-builder --win --x64 --dir",
    "desktop:dist": "pnpm build && electron-builder --win --x64",
    "test:desktop": "node --test desktop/assets.test.cjs && playwright test --config playwright.desktop.config.ts",
    "verify:desktop": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm audit:dist && pnpm test:desktop",
    "mobile:sync": "pnpm build && cap sync android",
    "mobile:open": "pnpm mobile:sync && cap open android",
    "mobile:run": "pnpm mobile:sync && cap run android",
    "mobile:apk": "pnpm mobile:sync && cd android && gradlew.bat assembleDebug",
    "test:mobile-project": "node --test scripts/mobile-project.node-test.mjs",
    "verify:mobile": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm audit:dist && pnpm test:mobile-project && pnpm mobile:sync && pnpm test:e2e -- mobile.spec.ts",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "start": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-e2e.mjs",
    "audit:dist": "node scripts/audit-dist.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm audit:dist && pnpm test:e2e"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "8.0.1",
    "@hookform/resolvers": "^5.9.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-router": "^8.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
