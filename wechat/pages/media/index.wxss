.summary { display: flex; justify-content: space-between; padding: 24rpx; margin: 24rpx 0; background: var(--surface); border: 1rpx solid var(--border); border-radius: 16rpx; }
.field { margin-bottom: 24rpx; }
.field input, .field textarea, .choice { box-sizing: border-box; width: 100%; min-height: 88rpx; background: #f3f6f8; padding: 16rpx; border-radius: 8rpx; }
.field textarea { height: 180rpx; }
.field label { display: block; margin-bottom: 8rpx; }
.metrics { display: flex; flex-wrap: wrap; }
.metrics .field { width: 50%; box-sizing: border-box; padding-right: 12rpx; }
.record-title { font-size: 34rpx; font-weight: 600; word-break: break-all; }
.badge { color: var(--primary); font-size: 26rpx; }
.record-details { white-space: pre-wrap; word-break: break-all; margin-top: 16rpx; }
