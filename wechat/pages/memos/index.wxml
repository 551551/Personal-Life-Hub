<view class="page">
  <view class="heading">随手记下，安心保存</view>
  <view class="subtitle">个人中心 · 快速备忘</view>
  <navigator url="/pages/media/index" class="panel">自媒体工作台 →</navigator>
  <navigator url="/pages/research/index" open-type="switchTab" class="panel">科研项目与里程碑 →</navigator>
  <view class="panel">
    <view class="label">{{editingId ? '编辑备忘' : '新增备忘'}}</view>
    <textarea class="editor" value="{{draft}}" bindinput="onInput" maxlength="2000" disabled="{{busy}}" placeholder="写下今天的想法或待办事项……" aria-label="备忘内容" />
    <view class="muted">{{draft.length}} / 2000 字</view>
    <view class="actions">
      <button class="primary" bindtap="onSave" loading="{{busy}}" disabled="{{busy || !draft.length}}">{{busy ? '正在保存' : '保存备忘'}}</button>
      <button wx:if="{{editingId}}" bindtap="onCancel" disabled="{{busy}}">取消编辑</button>
    </view>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <view class="label">我的备忘 · {{total}} 条</view>
  <view wx:if="{{!total}}" class="panel muted">还没有备忘。在上方写下第一条记录吧。</view>
  <view wx:for="{{items}}" wx:key="id" class="panel">
    <text class="content" selectable>{{item.content}}</text>
    <view class="actions">
      <button bindtap="onEdit" data-id="{{item.id}}" disabled="{{busy}}">编辑</button>
      <button class="danger" bindtap="onDelete" data-id="{{item.id}}" disabled="{{busy}}">删除</button>
    </view>
  </view>
  <button wx:if="{{total > items.length}}" bindtap="onMore">加载更多</button>
  <view class="footnote">记录仅保存在当前设备，不会自动同步。请勿清理小程序数据；请定期在数据与设置中导出备份。</view>
</view>
