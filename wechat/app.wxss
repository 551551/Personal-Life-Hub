page {
  --primary: #0f766e;
  --text: #0f172a;
  --muted: #64748b;
  --surface: #ffffff;
  --border: #dbe4ea;
  background: #f3f6f8;
  color: var(--text);
  font-size: 30rpx;
  line-height: 1.6;
}
.page { padding: 32rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); max-width: 960rpx; margin: auto; }
.heading { font-size: 44rpx; font-weight: 700; }
.subtitle { color: var(--muted); margin: 8rpx 0 32rpx; }
.panel { background: var(--surface); border: 1rpx solid var(--border); border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.label { font-weight: 600; margin-bottom: 16rpx; }
.muted { color: var(--muted); font-size: 26rpx; }
button { min-height: 96rpx; font-size: 28rpx; border-radius: 12rpx; margin: 0; }
.primary { background: var(--primary); color: #ffffff; }
.actions { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.actions button { flex: 1; margin-right: 12rpx; }
.actions button:last-child { margin-right: 0; }
.error { color: #991b1b; background: #fef2f2; padding: 20rpx; border-radius: 12rpx; margin-bottom: 24rpx; }
.notice { color: #115e59; padding: 16rpx 0; }
.danger { color: #991b1b; }
